# --- Alpaca PAPER account (REQUIRED) ------------------------------------
# Get keys at https://app.alpaca.markets -> Paper Trading -> API Keys.
# The endpoint MUST contain "paper" — scripts/alpaca.sh exits with code 2
# otherwise. Live trading is NOT part of this project.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_DATA_ENDPOINT=https://data.alpaca.markets/v2

# --- Perplexity (OPTIONAL) ----------------------------------------------
# Leave empty to start: scripts/perplexity.sh falls back to Claude's
# native WebSearch. Add later if research needs citations.
PERPLEXITY_API_KEY=

# --- ClickUp (OPTIONAL) -------------------------------------------------
# Leave empty: scripts/clickup.sh falls back to memory/DAILY-SUMMARY.md
# (committed to the repo, readable from GitHub).
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=
